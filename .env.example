# ==========================================================
# SignSpeak Environment Configuration
# ==========================================================

APP_NAME=SignSpeak API
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Database URL
# SQLite local: sqlite+aiosqlite:///./signspeak.db
# PostgreSQL:  postgresql+asyncpg://signspeak:signspeak_password@localhost:5432/signspeak
DATABASE_URL=sqlite+aiosqlite:///./signspeak.db
DB_ECHO=False

# Machine Learning Model Configuration
MODEL_WEIGHTS_PATH=ml_model/weights/sign_classifier.joblib
MIN_CONFIDENCE_THRESHOLD=0.65
STABILITY_FRAME_COUNT=5
AUTO_TTS_ENABLED=True

# Frontend URL for CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
